package semmiedev.disc_jockey.mixin;

import net.minecraft.client.Minecraft;
import net.minecraft.client.gui.render.GuiRenderer;
import org.spongepowered.asm.mixin.Mixin;
import org.spongepowered.asm.mixin.injection.At;
import org.spongepowered.asm.mixin.injection.Inject;
import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;

import java.lang.reflect.Field;
import java.lang.reflect.Method;
import java.lang.reflect.Modifier;

/**
 * 26.4-snapshot-8: FrontendRenderPass.enableScissor 对 0 尺寸裁剪区直接抛异常。
 * 仅当当前 screen 是 Disc Jockey 界面时成对跳过 scissor 开关，保持状态机一致。
 * 反射取 Minecraft 的 screen 字段，避免依赖混淆后的字段名。
 */
@Mixin(GuiRenderer.class)
public class DjScissorMixin {
    private static Field djScreenField = null;
    private static boolean djProbed = false;
    private static boolean djLogged = false;
    private static boolean djErrLogged = false;

    private static Field findScreenField(Class<?> type) {
        for (String name : new String[]{"screen", "currentScreen"}) {
            Class<?> c = type;
            while (c != null) {
                try { return c.getDeclaredField(name); } catch (NoSuchFieldException ignored) { c = c.getSuperclass(); }
            }
        }
        Class<?> c = type;
        while (c != null) {
            for (Field f : c.getDeclaredFields()) {
                if (!Modifier.isStatic(f.getModifiers()) && f.getType().getName().contains("Screen")) return f;
            }
            c = c.getSuperclass();
        }
        return null;
    }

    private static boolean djActive() {
        try {
            Method g = Minecraft.class.getMethod("getInstance");
            Object mc = g.invoke(null);
            if (mc == null) return false;
            if (!djProbed) {
                djProbed = true;
                djScreenField = findScreenField(mc.getClass());
                if (djScreenField != null) djScreenField.setAccessible(true);
                System.out.println("[DJ_SCISSOR_MIXIN] screen field = " +
                    (djScreenField == null ? "NOT FOUND" : djScreenField.getName()));
            }
            if (djScreenField == null) return false;
            Object s = djScreenField.get(mc);
            if (s == null) return false;
            return s.getClass().getName().startsWith("semmiedev.disc_jockey.gui.screen");
        } catch (Throwable t) {
            if (!djErrLogged) { djErrLogged = true; System.out.println("[DJ_SCISSOR_MIXIN] probe error: " + t); }
            return false;
        }
    }

    @Inject(method = "enableScissor", at = @At("HEAD"), cancellable = true)
    private void djSkipEnableScissor(CallbackInfo ci) {
        if (!djActive()) return;
        if (!djLogged) { djLogged = true; System.out.println("[DJ_SCISSOR_MIXIN] active - scissor skipped"); }
        ci.cancel();
    }

    @Inject(method = "disableScissor", at = @At("HEAD"), cancellable = true, require = 0)
    private void djSkipDisableScissor(CallbackInfo ci) {
        if (djActive()) ci.cancel();
    }
}