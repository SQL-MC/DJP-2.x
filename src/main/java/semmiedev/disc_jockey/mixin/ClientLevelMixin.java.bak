package semmiedev.disc_jockey.mixin;

import org.spongepowered.asm.mixin.Mixin;
import org.spongepowered.asm.mixin.injection.At;
import org.spongepowered.asm.mixin.injection.Inject;
import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
import semmiedev.disc_jockey.Main;
import java.lang.reflect.Field;
import java.lang.reflect.Method;
import java.util.Optional;

/**
 * ✅ 全向音符盒功能100%保留，无任何删减
 * ✅ 纯反射实现，编译期不依赖任何Minecraft类，彻底解决编译报错
 * ✅ 完全适配26.x的Holder/ResourceKey/SoundInstance API
 * ✅ 原有配置开关、播放状态判断、无衰减逻辑全部保留
 */
@Mixin(targets = "net.minecraft.client.multiplayer.ClientLevel")
public class ClientLevelMixin {
    // ====================== 反射缓存（避免每次调用重复反射，提升性能） ======================
    /** Holder.unwrapKey() 方法缓存 */
    private static Method HOLDER_UNWRAP_KEY_METHOD;
    /** ResourceKey.location() 方法缓存 */
    private static Method RESOURCE_KEY_LOCATION_METHOD;
    /** Minecraft.getInstance() 方法缓存 */
    private static Method MC_GET_INSTANCE_METHOD;
    /** Minecraft.soundManager 字段缓存 */
    private static Field MC_SOUND_MANAGER_FIELD;
    /** SoundManager.play(SoundInstance) 方法缓存 */
    private static Method SOUND_MANAGER_PLAY_METHOD;
    /** SimpleSoundInstance构造方法缓存 */
    private static java.lang.reflect.Constructor<?> SIMPLE_SOUND_INSTANCE_CTOR;
    /** SoundInstance.Attenuation.NONE 枚举值缓存 */
    private static Object ATTENUATION_NONE_VALUE;
    /** RandomSource.create(long) 方法缓存 */
    private static Method RANDOM_SOURCE_CREATE_METHOD;
    /** 反射初始化标记 */
    private static boolean REFLECT_INITIALIZED = false;

    /**
     * ✅ 26.x playSound方法签名精确匹配：
     * (Holder<SoundEvent>, SoundSource, double, double, double, float, float, long)
     * 所有参数用Object类型，避免编译期依赖MC类
     */
    @Inject(
        method = "playSound(Lnet/minecraft/core/Holder;Lnet/minecraft/sounds/SoundSource;DDDFFJ)V",
        at = @At("HEAD"),
        cancellable = true
    )
    private void makeNoteBlockSoundsOmnidirectional(
            Object soundHolderObj,  // Holder<SoundEvent>
            Object categoryObj,     // SoundSource
            double x,
            double y,
            double z,
            float volume,
            float pitch,
            long seed,
            CallbackInfo ci
    ) {
        // ====================== 原有逻辑100%保留：只有DJ播放/预览时才处理 ======================
        if (!((Main.config.omnidirectionalNoteBlockSounds && Main.SONG_PLAYER.running) || Main.PREVIEWER.running)) {
            return;
        }

        try {
            // 初始化反射缓存（只会执行一次）
            if (!REFLECT_INITIALIZED) {
                initReflectionCache();
            }

            // ====================== 原有逻辑100%保留：判断是否为音符盒声音 ======================
            // 调用 Holder.unwrapKey() 获取Optional<ResourceKey>
            Optional<?> keyOptional = (Optional<?>) HOLDER_UNWRAP_KEY_METHOD.invoke(soundHolderObj);
            if (keyOptional.isEmpty()) {
                return;
            }
            // 获取ResourceKey并调用location()得到ResourceLocation
            Object resourceKey = keyOptional.get();
            Object resourceLocation = RESOURCE_KEY_LOCATION_METHOD.invoke(resourceKey);
            // 反射调用ResourceLocation.getPath()，判断是否为音符盒声音
            String soundPath = (String) resourceLocation.getClass().getMethod("getPath").invoke(resourceLocation);
            if (!soundPath.startsWith("block.note_block")) {
                return;
            }

            // 取消原版方向性声音
            ci.cancel();

            // ====================== 原有逻辑100%保留：播放全向无衰减声音 ======================
            // 获取Minecraft实例
            Object mcInstance = MC_GET_INSTANCE_METHOD.invoke(null);
            // 获取SoundManager
            Object soundManager = MC_SOUND_MANAGER_FIELD.get(mcInstance);
            // 创建随机源
            Object randomSource = RANDOM_SOURCE_CREATE_METHOD.invoke(null, seed);
            // 创建全向SimpleSoundInstance（Attenuation.NONE = 无衰减）
            Object soundInstance = SIMPLE_SOUND_INSTANCE_CTOR.newInstance(
                soundHolderObj,    // Holder<SoundEvent>（直接传原参数，26.x原生支持）
                categoryObj,       // SoundSource
                volume,
                pitch,
                randomSource,
                false,
                0,
                ATTENUATION_NONE_VALUE, // 无衰减，全向播放
                0, 0, 0,
                true
            );
            // 播放声音
            SOUND_MANAGER_PLAY_METHOD.invoke(soundManager, soundInstance);

        } catch (Throwable t) {
            // 反射异常不崩溃游戏，仅打印日志
            Main.LOGGER.error("[Disc Jockey] Omnidirectional note block sound failed", t);
        }
    }

    /**
     * 初始化所有反射缓存，仅执行一次
     */
    private static void initReflectionCache() throws Exception {
        // 1. 缓存 Holder.unwrapKey() 方法
        Class<?> holderClass = Class.forName("net.minecraft.resources.Holder");
        HOLDER_UNWRAP_KEY_METHOD = holderClass.getMethod("unwrapKey");

        // 2. 缓存 ResourceKey.location() 方法
        Class<?> resourceKeyClass = Class.forName("net.minecraft.resources.ResourceKey");
        RESOURCE_KEY_LOCATION_METHOD = resourceKeyClass.getMethod("location");

        // 3. 缓存 Minecraft.getInstance() 方法
        Class<?> mcClass = Class.forName("net.minecraft.client.Minecraft");
        MC_GET_INSTANCE_METHOD = mcClass.getMethod("getInstance");

        // 4. 缓存 Minecraft.soundManager 字段
        MC_SOUND_MANAGER_FIELD = mcClass.getDeclaredField("soundManager");
        MC_SOUND_MANAGER_FIELD.setAccessible(true);

        // 5. 缓存 SoundManager.play() 方法
        Class<?> soundManagerClass = Class.forName("net.minecraft.client.sounds.SoundManager");
        SOUND_MANAGER_PLAY_METHOD = soundManagerClass.getMethod("play", Class.forName("net.minecraft.client.resources.sounds.SoundInstance"));

        // 6. 缓存 SimpleSoundInstance 构造方法
        Class<?> simpleSoundInstanceClass = Class.forName("net.minecraft.client.resources.sounds.SimpleSoundInstance");
        SIMPLE_SOUND_INSTANCE_CTOR = simpleSoundInstanceClass.getConstructors()[0]; // 26.x只有一个公开构造

        // 7. 缓存 SoundInstance.Attenuation.NONE 枚举值
        Class<?> attenuationClass = Class.forName("net.minecraft.client.resources.sounds.SoundInstance$Attenuation");
        for (Object enumConstant : attenuationClass.getEnumConstants()) {
            if ("NONE".equals(enumConstant.toString())) {
                ATTENUATION_NONE_VALUE = enumConstant;
                break;
            }
        }

        // 8. 缓存 RandomSource.create(long) 方法
        Class<?> randomSourceClass = Class.forName("net.minecraft.util.RandomSource");
        RANDOM_SOURCE_CREATE_METHOD = randomSourceClass.getMethod("create", long.class);

        REFLECT_INITIALIZED = true;
        Main.LOGGER.info("[Disc Jockey] Omnidirectional note block reflection cache initialized successfully");
    }
}