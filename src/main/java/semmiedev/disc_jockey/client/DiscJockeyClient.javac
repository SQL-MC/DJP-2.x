package semmiedev.disc_jockey.client;

import net.fabricmc.api.ClientModInitializer;
import net.fabricmc.fabric.api.client.rendering.v1.hud.HudElementRegistry;
import net.minecraft.client.Minecraft;
import net.minecraft.resources.Identifier;
import net.minecraft.client.gui.DeltaTracker;
import semmiedev.disc_jockey.Main;

public class DiscJockeyClient implements ClientModInitializer {

    @Override
    public void onInitializeClient() {
        Identifier spectrumLayer = Identifier.fromNamespaceAndPath(Main.MOD_ID, "spectrum");

        HudElementRegistry.addLast(spectrumLayer, (graphics, deltaTracker) -> {
            if (Main.config == null || !Main.config.spectrumAlwaysVisible) return;
            if (!Main.SONG_PLAYER.running && !Main.PREVIEWER.running) return;

            Minecraft mc = Minecraft.getInstance();
            int width = mc.getWindow().getGuiScaledWidth();
            int height = mc.getWindow().getGuiScaledHeight();
            int bottomY = height - 55;

            semmiedev.disc_jockey.gui.screen.spectrum.SpectrumRendererManager.getCurrent().render(
                graphics,
                width,
                height,
                Main.SPECTRUM.currentLevels,
                15,
                bottomY
            );
        });
    }
}